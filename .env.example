# No source API keys are required. Host/port are server.py arguments.
# Use a persistent mount for the deployed SQLite database.
# FINN_DATA_DIR=/var/data/finn
# The Render Blueprint generates a private demo password automatically.
# FINN_REQUIRE_AUTH=1
# FINN_DEMO_PASSWORD=<set securely; at least 16 characters>
# Hosting automation only; add as a secure secret, never commit the actual key.
# RENDER_API_KEY=<set securely>
